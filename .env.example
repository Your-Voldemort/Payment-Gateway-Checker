# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
OWNER_USER_ID=your_user_id_here

# Contact Information
CONTACT_USERNAME=volde_is_back
BOT_USERNAME=UrlDebugger_bot

# Bot Settings
REQUEST_TIMEOUT=10
MAX_URLS_PER_REQUEST=10
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60

# User Agent Settings (for minimizing rate limiting)
USER_AGENT_ROTATION=true
USER_AGENT_TYPE=all  # Options: all, desktop, mobile, chrome, firefox, safari, edge, android, ios

# Database
USER_IDS_FILE=user_ids.txt
LOG_FILE=bot.log

# Optional: route the bot + scanner through a proxy if your network blocks Telegram.
# Supports http, https, socks4, socks5. Requires aiohttp-socks (in requirements.txt).
# PROXY_URL=socks5://user:pass@host:port
# PROXY_URL=http://host:port
# Or rotate over multiple (comma-separated); one is chosen per process start:
# PROXY_LIST=socks5://host1:1080,http://host2:8080
# Or load proxies from a file (one per line) — see proxies.txt.example:
# PROXY_FILE=proxies.txt
